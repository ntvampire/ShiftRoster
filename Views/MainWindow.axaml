<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShiftRoster.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="ShiftRoster.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1366" Height="768"
        MinWidth="900" MinHeight="600"
        Background="#1C1C1C">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ВЕРХНЯЯ ПАНЕЛЬ УПРАВЛЕНИЯ -->
        <Border Grid.Row="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                
                <!-- Название приложения и выбор смены/поста -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Border Background="#0078D4" CornerRadius="6" Width="32" Height="32">
                        <TextBlock Text="📅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="График смен" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        <!-- Выпадающий список выбора текущей смены/поста -->
                        <ComboBox ItemsSource="{Binding AvailablePosts}" 
                                  SelectedItem="{Binding SelectedPost}"
                                  MinWidth="170" Height="26" FontSize="11" 
                                  Padding="6,2" ToolTip.Tip="Переключить смену / пост" />
                    </StackPanel>
                </StackPanel>

                <!-- Навигация по месяцам -->
                <Border Grid.Column="1" Margin="16,0,0,0" Background="#1E1E1E" CornerRadius="6" BorderBrush="#383838" BorderThickness="1" Padding="4">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{Binding PrevMonthCommand}" Content="◀" Width="30" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Предыдущий месяц" />
                        <TextBlock Text="{Binding CurrentMonthName}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Text="{Binding CurrentYear}" FontWeight="SemiBold" Foreground="#0078D4" VerticalAlignment="Center" Margin="2,0,6,0" />
                        <Button Command="{Binding NextMonthCommand}" Content="▶" Width="30" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Следующий месяц" />
                    </StackPanel>
                </Border>

                <!-- Основные команды / Кнопки действий -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="SetupWizardButton" Background="#005A9E" ToolTip.Tip="Мастер быстрой первичной настройки смен и сотрудников">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🧙" />
                            <TextBlock Text="Мастер настройки" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ManageEmployeesButton" ToolTip.Tip="Управление сотрудниками, сменами и днями старта графиков">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="👥" />
                            <TextBlock Text="Штат и смены" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AutoFillOneThreeCommand}" ToolTip.Tip="Автоматически заполнить график по схеме «Сутки через трое» с учетом стартовых дней сотрудников">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="⚡" />
                            <TextBlock Text="Сутки/трое" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AutoFillTwoTwoCommand}" ToolTip.Tip="Автоматически заполнить график по схеме «2 через 2» (по 12ч)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="⚡" />
                            <TextBlock Text="2 через 2" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="AssignSubstituteButton" Classes="accent" ToolTip.Tip="Назначить временного сменщика взамен сотрудника в отпуске или на больничном">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🔄" />
                            <TextBlock Text="Назначить подмену" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExportExcelButton" ToolTip.Tip="Экспорт в Excel (левый клик — текущая смена, правый клик — все смены)">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ExportCurrentMenuItem" Header="Экспортировать текущую смену в Excel" />
                                <MenuItem x:Name="ExportAllMenuItem" Header="📑 Экспортировать ВСЕ смены в общий сводный отчет" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📊" />
                            <TextBlock Text="В Excel (1C)" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExportConsolidatedButton" ToolTip.Tip="Сформировать общий единый отчет по ВСЕМ сменам предприятия сразу">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📑" />
                            <TextBlock Text="Все смены в Excel" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SyncCalendarCommand}" ToolTip.Tip="Обновить производственный календарь РФ из интернета">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🌐" />
                            <TextBlock Text="Календарь РФ" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveRosterCommand}" ToolTip.Tip="Сохранить изменения в базе данных">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="💾" />
                            <TextBlock Text="Сохранить" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПЛАШКА ПРОВЕРКИ СУТОЧНОГО БАЛАНСА (24 ЧАСА В ДЕНЬ) -->
        <Border Grid.Row="1" Background="{Binding BalanceBannerBackground}" Margin="12,8,12,4" CornerRadius="6" Padding="12,7">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="⏱" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding BalanceStatusBanner}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" FontSize="13" />
            </Grid>
        </Border>

        <!-- ГЛАВНАЯ СЕТКА ТАБЕЛЯ (ТАБЛИЦА) -->
        <Border Grid.Row="2" Margin="12,6,12,6" Background="#222222" CornerRadius="8" BorderBrush="#333333" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    
                    <!-- ШАПКА ТАБЛИЦЫ (Заголовки дней и сводки) -->
                    <Border Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="4,6">
                        <StackPanel Orientation="Horizontal">
                            <!-- Колонка сотрудника -->
                            <Border Width="240" Padding="8,4">
                                <TextBlock Text="Сотрудник / Должность" FontWeight="SemiBold" Foreground="#E0E0E0" FontSize="13" />
                            </Border>

                            <!-- Колонки дней месяца (1..31) -->
                            <ItemsControl ItemsSource="{Binding DayHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DayColumnHeaderViewModel">
                                        <Border Width="38" Height="40" Margin="1,0" CornerRadius="4"
                                                Background="{Binding HeaderBackground}"
                                                BorderBrush="{Binding HeaderBorderBrush}"
                                                BorderThickness="1"
                                                ToolTip.Tip="{Binding Tooltip}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DayOfMonth}" FontWeight="Bold" FontSize="12" 
                                                           Foreground="White" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding DayOfWeekName}" FontSize="10" 
                                                           Foreground="#AAAAAA" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Заголовки итоговых колонок -->
                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                <Border Width="50" Padding="2"><TextBlock Text="Всего ч" FontWeight="SemiBold" FontSize="11" Foreground="#0078D4" HorizontalAlignment="Center" /></Border>
                                <Border Width="45" Padding="2"><TextBlock Text="День" FontWeight="SemiBold" FontSize="11" Foreground="#E0E0E0" HorizontalAlignment="Center" /></Border>
                                <Border Width="45" Padding="2"><TextBlock Text="Ночь" FontWeight="SemiBold" FontSize="11" Foreground="#9E86FF" HorizontalAlignment="Center" /></Border>
                                <Border Width="50" Padding="2"><TextBlock Text="Праздн." FontWeight="SemiBold" FontSize="11" Foreground="#FF6B6B" HorizontalAlignment="Center" ToolTip.Tip="Праздничные часы (двойная оплата по производственному календарю РФ)" /></Border>
                                <Border Width="45" Padding="2"><TextBlock Text="Отпуск" FontWeight="SemiBold" FontSize="11" Foreground="#4ECA78" HorizontalAlignment="Center" /></Border>
                                <Border Width="45" Padding="2"><TextBlock Text="Больн." FontWeight="SemiBold" FontSize="11" Foreground="#F0A04B" HorizontalAlignment="Center" /></Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- СТРОКИ СОТРУДНИКОВ -->
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EmployeeRosterRowViewModel">
                                <Border BorderBrush="#303030" BorderThickness="0,0,0,1" Padding="4,3">
                                    <StackPanel Orientation="Horizontal">
                                        
                                        <!-- Карточка сотрудника слева -->
                                        <Border Width="240" Padding="8,4">
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Position}" Foreground="#999999" FontSize="11" />
                                                    <Border Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1" Margin="2,0,0,0">
                                                        <TextBlock Text="{Binding DisplayBadge}" FontSize="9" Foreground="White" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Ячейки дней для этого сотрудника -->
                                        <ItemsControl ItemsSource="{Binding DayCells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RosterCellViewModel">
                                                    <Button Width="38" Height="36" Margin="1,0" Padding="0"
                                                            CornerRadius="4"
                                                            Background="{Binding CellBackground}"
                                                            BorderBrush="{Binding CellBorderBrush}"
                                                            BorderThickness="1"
                                                            ToolTip.Tip="{Binding TooltipText}"
                                                            Click="OnCellButtonClicked">
                                                        <TextBlock Text="{Binding DisplayText}" 
                                                                   FontWeight="SemiBold" FontSize="12" 
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Итоговые показатели по сотруднику -->
                                        <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Border Width="50"><TextBlock Text="{Binding TotalHours, StringFormat='{}{0:0.#}'}" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Center" /></Border>
                                            <Border Width="45"><TextBlock Text="{Binding DayHours, StringFormat='{}{0:0.#}'}" Foreground="#CCCCCC" HorizontalAlignment="Center" /></Border>
                                            <Border Width="45"><TextBlock Text="{Binding NightHours, StringFormat='{}{0:0.#}'}" Foreground="#9E86FF" HorizontalAlignment="Center" /></Border>
                                            <Border Width="50"><TextBlock Text="{Binding HolidayHours, StringFormat='{}{0:0.#}'}" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" /></Border>
                                            <Border Width="45"><TextBlock Text="{Binding VacationDays}" Foreground="#4ECA78" HorizontalAlignment="Center" /></Border>
                                            <Border Width="45"><TextBlock Text="{Binding SickDays}" Foreground="#F0A04B" HorizontalAlignment="Center" /></Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ИТОГОВАЯ СТРОКА: БАЛАНС ПО ПОСТУ (ЧАСОВ В СУТКИ) -->
                    <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,2,0,0" Padding="4,6">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="240" Padding="8,4">
                                <TextBlock Text="ИТОГО ПО ПОСТУ (ч/сут):" FontWeight="Bold" Foreground="#0078D4" FontSize="12" VerticalAlignment="Center" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding DayBalances}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DayBalanceViewModel">
                                        <Border Width="38" Height="28" Margin="1,0" CornerRadius="4"
                                                Background="{Binding BackgroundColor}"
                                                ToolTip.Tip="{Binding TooltipText}">
                                            <TextBlock Text="{Binding DisplayText}" 
                                                       FontWeight="Bold" FontSize="11" 
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Width="280" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="Норма: ровно 24ч в сутки" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- НИЖНЯЯ ПАНЕЛЬ: БЫСТРАЯ ПАЛИТРА СМЕН И СТРОКА СОСТОЯНИЯ -->
        <Border Grid.Row="3" Background="#202020" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                
                <!-- Палитра быстрого назначения смены для выбранной ячейки -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Быстрая смена:" VerticalAlignment="Center" Foreground="#888888" FontSize="12" Margin="0,0,6,0" />

                    <Button Command="{Binding ApplyShiftCommand}" CommandParameter="16" 
                            Background="#1F3B5C" ToolTip.Tip="16 часов: заступление на смену (14ч день + 2ч ночь)">
                        <TextBlock Text="16ч (Заступл.)" FontSize="12" Foreground="White" />
                    </Button>

                    <Button Command="{Binding ApplyShiftCommand}" CommandParameter="8" 
                            Background="#2D2750" ToolTip.Tip="8 часов: сдача смены утром (2ч день + 6ч ночь)">
                        <TextBlock Text="8ч (Сдача)" FontSize="12" Foreground="White" />
                    </Button>

                    <Button Command="{Binding ApplyShiftCommand}" CommandParameter="Д12" 
                            Background="#2B4036" ToolTip.Tip="Дневная смена: 12 часов">
                        <TextBlock Text="12ч (День)" FontSize="12" Foreground="White" />
                    </Button>

                    <Button Command="{Binding ApplyShiftCommand}" CommandParameter="Н12" 
                            Background="#3E2C58" ToolTip.Tip="Ночная смена: 12 часов">
                        <TextBlock Text="12ч (Ночь)" FontSize="12" Foreground="White" />
                    </Button>

                    <Button Command="{Binding ApplyShiftCommand}" CommandParameter="В" 
                            Background="#282828" ToolTip.Tip="Выходной день (В)">
                        <TextBlock Text="Выходной (В)" FontSize="12" Foreground="#AAAAAA" />
                    </Button>

                    <Button Command="{Binding ApplyShiftCommand}" CommandParameter="О" 
                            Background="#1B4D2E" ToolTip.Tip="Отпуск (О)">
                        <TextBlock Text="Отпуск (О)" FontSize="12" Foreground="#84E1A7" />
                    </Button>

                    <Button Command="{Binding ApplyShiftCommand}" CommandParameter="Б" 
                            Background="#5A3D1A" ToolTip.Tip="Больничный лист (Б)">
                        <TextBlock Text="Больничный (Б)" FontSize="12" Foreground="#F5C070" />
                    </Button>
                </StackPanel>

                <!-- Статусное сообщение -->
                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" 
                           Foreground="#999999" FontSize="12" VerticalAlignment="Center" 
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

    </Grid>
</Window>
