<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShiftRoster.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="ShiftRoster.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1366" Height="768"
        MinWidth="960" MinHeight="600"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Grid ColumnDefinitions="Auto,*">

        <!-- ======================================================== -->
        <!-- ЛЕВАЯ СВОРАЧИВАЕМАЯ ПАНЕЛЬ ДЕЙСТВИЙ И НАВИГАЦИИ           -->
        <!-- ======================================================== -->
        <Border Grid.Column="0" 
                IsVisible="{Binding IsSidebarOpen}" 
                Width="240" 
                Background="{DynamicResource AppSidebarBackgroundBrush}" 
                BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Margin="12,14">

                    <!-- Заголовок панели -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding OrganizationName}" FontSize="11" Foreground="#0078D4" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="График смен" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ToggleSidebarCommand}" 
                                Content="◀" Width="28" Height="28" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Свернуть боковую панель" Background="Transparent" BorderThickness="0" />
                    </Grid>

                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,2" />

                    <!-- БЛОК 1: ПОДРАЗДЕЛЕНИЕ / СМЕНА -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="ПОДРАЗДЕЛЕНИЕ / СМЕНА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                        
                        <ComboBox ItemsSource="{Binding AvailablePosts}" 
                                  SelectedItem="{Binding SelectedPost}"
                                  HorizontalAlignment="Stretch" Height="32" FontSize="12" 
                                  ToolTip.Tip="Выберите текущее подразделение" />

                        <!-- Кнопки: Новая смена и Удалить смену -->
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0" x:Name="AddNewPostSidebarButton" 
                                    Content="➕ Новая" Height="30" Margin="0,0,3,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Classes="accent" FontSize="11"
                                    ToolTip.Tip="Создать новое подразделение или пост" />

                            <Button Grid.Column="1" x:Name="DeletePostSidebarButton" 
                                    Content="🗑️ Удалить" Height="30" Margin="3,0,0,0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{DynamicResource AppDeleteButtonBackgroundBrush}" 
                                    Foreground="{DynamicResource AppDeleteButtonForegroundBrush}" FontSize="11"
                                    ToolTip.Tip="Удалить текущее подразделение и все его графики" />
                        </Grid>
                    </StackPanel>

                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,2" />

                    <!-- БЛОК 2: ШТАТ И ГРАФИК -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="ШТАТ И НАСТРОЙКА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextTertiaryBrush}" />

                        <Button x:Name="ManageEmployeesSidebarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="👥" FontSize="14" />
                                <TextBlock Text="Штат и очередность" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="SetupWizardSidebarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🧙" FontSize="14" />
                                <TextBlock Text="Мастер настройки" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AutoFillCurrentScheduleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34" ToolTip.Tip="Автоматически заполнить график по схеме подразделения">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚡" FontSize="14" />
                                <TextBlock Text="Заполнить по графику" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,2" />

                    <!-- БЛОК 3: ОТСУТСТВИЯ И ПОДМЕНЫ -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="ОТСУТСТВИЯ И ПОДМЕНЫ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextTertiaryBrush}" />

                        <Button x:Name="AssignAbsencePeriodSidebarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34" ToolTip.Tip="Массово выставить отпуск или больничный сотруднику на период дат">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📅" FontSize="14" />
                                <TextBlock Text="Период отсутствия..." VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="AssignSubstituteSidebarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34" ToolTip.Tip="Назначить временного подменного работника взамен основного">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🔄" FontSize="14" />
                                <TextBlock Text="Назначить подмену" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="RemoveSubstituteSidebarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34" ToolTip.Tip="Снять подмену и удалить строку подменного из графика на этот месяц">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="❌" FontSize="14" />
                                <TextBlock Text="Снять подмену..." VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ManageSubstitutesSidebarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34" ToolTip.Tip="Справочник и управление всеми подменными работниками организации">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📋" FontSize="14" />
                                <TextBlock Text="База подменных..." VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,2" />

                    <!-- БЛОК 4: ЭКСПОРТ В EXCEL (1C) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="ОТЧЕТЫ И ЭКСПОРТ В 1С" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextTertiaryBrush}" />

                        <Button x:Name="ExportExcelSidebarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34" ToolTip.Tip="Экспорт текущей смены (Т-13 + ведомость для 1С)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📊" FontSize="14" />
                                <TextBlock Text="В Excel (эта смена)" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ExportConsolidatedSidebarButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="34" ToolTip.Tip="Сформировать единый сводный отчет сразу по ВСЕМ сменам">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📑" FontSize="14" />
                                <TextBlock Text="Сводный отчет (все)" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,2" />

                    <!-- БЛОК 5: СЕРВИС -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="СЕРВИС" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextTertiaryBrush}" />

                        <Button Command="{Binding SyncCalendarCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🌐" FontSize="13" />
                                <TextBlock Text="Календарь РФ" VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SaveRosterCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="💾" FontSize="13" />
                                <TextBlock Text="Сохранить график" VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ClearCurrentMonthRosterCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Height="32" ToolTip.Tip="Очистить смены текущего месяца (выставить 'В')">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🧹" FontSize="13" />
                                <TextBlock Text="Очистить месяц" VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ======================================================== -->
        <!-- ПРАВАЯ ЧАСТЬ: ГЛАВНАЯ РАБОЧАЯ ОБЛАСТЬ                     -->
        <!-- ======================================================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">

            <!-- ВЕРХНЯЯ СТРОКА: ПЕРЕКЛЮЧАТЕЛЬ ПАНЕЛИ, МЕСЯЦ, СМЕНА, ПЕРЕКЛЮЧАТЕЛЬ ТЕМЫ -->
            <Border Grid.Row="0" Background="{DynamicResource AppHeaderBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    
                    <!-- Кнопка разворачивания панели и заголовок -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Button Command="{Binding ToggleSidebarCommand}" Content="☰ Меню" 
                                Height="30" Padding="8,4" FontSize="12"
                                ToolTip.Tip="Показать/скрыть боковую панель управления" />

                        <Border Background="{DynamicResource AppBadgeBackgroundBrush}" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding SelectedPost, StringFormat='Смена: {0}'}" 
                                           FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13" />
                                <TextBlock Text="•" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                                <TextBlock Text="{Binding CurrentPostPattern, StringFormat='Схема {0}'}" 
                                           Foreground="#0078D4" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Навигация по месяцам -->
                    <Border Grid.Column="1" Margin="16,0,0,0" Background="{DynamicResource AppBadgeBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Command="{Binding PrevMonthCommand}" Content="◀" Width="30" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Предыдущий месяц" />
                            <TextBlock Text="{Binding CurrentMonthName}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="13" />
                            <TextBlock Text="{Binding CurrentYear}" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" Margin="2,0,6,0" FontSize="13" />
                            <Button Command="{Binding NextMonthCommand}" Content="▶" Width="30" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Следующий месяц" />
                        </StackPanel>
                    </Border>

                    <!-- Переключатель темы (Авто / Тёмная / Светлая) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Тема:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                        <ComboBox SelectedIndex="{Binding SelectedThemeIndex}" Width="128" Height="30" FontSize="11">
                            <ComboBoxItem Content="🌓 Авто" ToolTip.Tip="Следовать за темой Windows" />
                            <ComboBoxItem Content="🌙 Тёмная" ToolTip.Tip="Принудительная тёмная тема" />
                            <ComboBoxItem Content="☀️ Светлая" ToolTip.Tip="Принудительная светлая тема" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ПЛАШКА ПРОВЕРКИ БАЛАНСА ПОСТА (24 ЧАСА В ДЕНЬ) -->
            <Border Grid.Row="1" Background="{Binding BalanceBannerBackground}" Margin="12,8,12,4" CornerRadius="6" Padding="12,7">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="⏱" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Text="{Binding BalanceStatusBanner}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" FontSize="13" />
                </Grid>
            </Border>

            <!-- ГЛАВНАЯ СЕТКА ТАБЕЛЯ (ТАБЛИЦА) -->
            <Border Grid.Row="2" Margin="12,6,12,6" Background="{DynamicResource AppCardBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        
                        <!-- ШАПКА ТАБЛИЦЫ -->
                        <Border Background="{DynamicResource AppTableHeaderBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="4,6">
                            <StackPanel Orientation="Horizontal">
                                <!-- Колонка сотрудника -->
                                <Border Width="240" Padding="8,4">
                                    <TextBlock Text="Сотрудник / Должность" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" />
                                </Border>

                                <!-- Колонки дней месяца (1..31) -->
                                <ItemsControl ItemsSource="{Binding DayHeaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DayColumnHeaderViewModel">
                                            <Border Width="38" Height="40" Margin="1,0" CornerRadius="4"
                                                    Background="{Binding HeaderBackground}"
                                                    BorderBrush="{Binding HeaderBorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip.Tip="{Binding Tooltip}">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding DayOfMonth}" FontWeight="Bold" FontSize="12" 
                                                               Foreground="{Binding DayForeground}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding DayOfWeekName}" FontSize="10" 
                                                               Foreground="{Binding DayOfWeekForeground}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Заголовки итоговых колонок -->
                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                    <Border Width="50" Padding="2"><TextBlock Text="Всего ч" FontWeight="SemiBold" FontSize="11" Foreground="#0078D4" HorizontalAlignment="Center" /></Border>
                                    <Border Width="45" Padding="2"><TextBlock Text="День" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center" /></Border>
                                    <Border Width="45" Padding="2"><TextBlock Text="Ночь" FontWeight="SemiBold" FontSize="11" Foreground="#9E86FF" HorizontalAlignment="Center" /></Border>
                                    <Border Width="50" Padding="2"><TextBlock Text="Праздн." FontWeight="SemiBold" FontSize="11" Foreground="#FF6B6B" HorizontalAlignment="Center" ToolTip.Tip="Праздничные часы (двойная оплата по производственному календарю РФ)" /></Border>
                                    <Border Width="45" Padding="2"><TextBlock Text="Отпуск" FontWeight="SemiBold" FontSize="11" Foreground="#4ECA78" HorizontalAlignment="Center" /></Border>
                                    <Border Width="45" Padding="2"><TextBlock Text="Больн." FontWeight="SemiBold" FontSize="11" Foreground="#F0A04B" HorizontalAlignment="Center" /></Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- СТРОКИ СОТРУДНИКОВ -->
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:EmployeeRosterRowViewModel">
                                    <Border BorderBrush="{DynamicResource AppRowBorderBrush}" BorderThickness="0,0,0,1" Padding="4,3">
                                        <StackPanel Orientation="Horizontal">
                                            
                                            <!-- Карточка сотрудника слева -->
                                            <Border Width="240" Padding="8,4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Position}" Foreground="{DynamicResource AppTextTertiaryBrush}" FontSize="11" />
                                                            <Border Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1" Margin="2,0,0,0">
                                                                <TextBlock Text="{Binding DisplayBadge}" FontSize="9" Foreground="White" FontWeight="Bold" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Кнопка быстрого снятия подмены / удаления строки -->
                                                    <Button Grid.Column="1" IsVisible="{Binding IsSubstitute}"
                                                            Content="🗑️" 
                                                            Width="26" Height="26" Padding="0" Margin="4,0,0,0"
                                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                            Background="{DynamicResource AppDeleteButtonBackgroundBrush}"
                                                            Foreground="{DynamicResource AppDeleteButtonForegroundBrush}"
                                                            CornerRadius="4"
                                                            FontSize="11"
                                                            ToolTip.Tip="Удалить подменного из табеля на этот месяц (с возвратом смен)"
                                                            Click="OnDeleteSubstituteRowClicked" />
                                                </Grid>
                                            </Border>

                                            <!-- Ячейки дней для этого сотрудника -->
                                            <ItemsControl ItemsSource="{Binding DayCells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RosterCellViewModel">
                                                        <Button Width="38" Height="36" Margin="1,0" Padding="0"
                                                                CornerRadius="4"
                                                                Background="{Binding CellBackground}"
                                                                BorderBrush="{Binding CellBorderBrush}"
                                                                BorderThickness="1"
                                                                ToolTip.Tip="{Binding TooltipText}"
                                                                Click="OnCellButtonClicked"
                                                                PointerPressed="OnCellPointerPressed"
                                                                PointerReleased="OnCellPointerReleased"
                                                                ContextRequested="OnCellContextRequested">
                                                            <TextBlock Text="{Binding DisplayText}" 
                                                                       FontWeight="SemiBold" FontSize="12" 
                                                                       Foreground="{Binding CellForeground}"
                                                                       HorizontalAlignment="Center" 
                                                                       VerticalAlignment="Center" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Итоговые показатели по сотруднику -->
                                            <StackPanel Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Border Width="50"><TextBlock Text="{Binding TotalHours, StringFormat='{}{0:0.#}'}" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Center" /></Border>
                                                <Border Width="45"><TextBlock Text="{Binding DayHours, StringFormat='{}{0:0.#}'}" Foreground="{DynamicResource AppTextSecondaryBrush}" HorizontalAlignment="Center" /></Border>
                                                <Border Width="45"><TextBlock Text="{Binding NightHours, StringFormat='{}{0:0.#}'}" Foreground="#9E86FF" HorizontalAlignment="Center" /></Border>
                                                <Border Width="50"><TextBlock Text="{Binding HolidayHours, StringFormat='{}{0:0.#}'}" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" /></Border>
                                                <Border Width="45"><TextBlock Text="{Binding VacationDays}" Foreground="#4ECA78" HorizontalAlignment="Center" /></Border>
                                                <Border Width="45"><TextBlock Text="{Binding SickDays}" Foreground="#F0A04B" HorizontalAlignment="Center" /></Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ИТОГОВАЯ СТРОКА: БАЛАНС ПО ПОСТУ (ЧАСОВ В СУТКИ) -->
                        <Border Background="{DynamicResource AppSummaryRowBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,2,0,0" Padding="4,6">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="240" Padding="8,4">
                                    <TextBlock Text="ИТОГО ПО ПОСТУ (ч/сут):" FontWeight="Bold" Foreground="#0078D4" FontSize="12" VerticalAlignment="Center" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding DayBalances}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DayBalanceViewModel">
                                            <Border Width="38" Height="28" Margin="1,0" CornerRadius="4"
                                                    Background="{Binding BackgroundColor}"
                                                    ToolTip.Tip="{Binding TooltipText}">
                                                <TextBlock Text="{Binding DisplayText}" 
                                                           FontWeight="Bold" FontSize="11" 
                                                           Foreground="{Binding ForegroundColor}"
                                                           HorizontalAlignment="Center" 
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Width="280" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Норма: ровно 24ч в сутки" FontSize="11" Foreground="{DynamicResource AppTextTertiaryBrush}" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- НИЖНЯЯ ПАНЕЛЬ: ЕДИНЫЙ БЛОК ПОДСКАЗОК И СТРОКА СОСТОЯНИЯ -->
            <Border Grid.Row="3" Background="{DynamicResource AppHeaderBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,7">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <!-- Единый блок подсказок по выделению, контекстному меню и быстрым клавишам -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="💡 Управление:" VerticalAlignment="Center" Foreground="{DynamicResource AppTextTertiaryBrush}" FontSize="11" Margin="0,0,2,0" />

                        <Border Background="{DynamicResource AppHintBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" ToolTip.Tip="Кликните первую ячейку, затем зажмите Shift и кликните вторую для выделения диапазона дней">
                            <TextBlock Text="Shift+Клик — диапазон" FontSize="11" Foreground="{DynamicResource AppHintBadgeForegroundBrush}" />
                        </Border>

                        <Border Background="{DynamicResource AppHintBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" ToolTip.Tip="Зажмите Ctrl и кликайте ячейки для выбора нескольких отдельных дней">
                            <TextBlock Text="Ctrl+Клик — выбор ячеек" FontSize="11" Foreground="{DynamicResource AppHintBadgeForegroundBrush}" />
                        </Border>

                        <Border Background="{DynamicResource AppHintBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" ToolTip.Tip="Кликните правой кнопкой мыши по любой ячейке или выделенному диапазону дней для выбора смены из меню">
                            <TextBlock Text="ПКМ — меню смен" FontSize="11" Foreground="#0078D4" FontWeight="SemiBold" />
                        </Border>

                        <Border Background="{DynamicResource AppHintBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" ToolTip.Tip="Нажмите 'Б' на клавиатуре для назначения больничного листа">
                            <TextBlock Text="Б — больничный" FontSize="11" Foreground="#D88200" FontWeight="SemiBold" />
                        </Border>

                        <Border Background="{DynamicResource AppHintBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" ToolTip.Tip="Нажмите 'О' на клавиатуре для назначения отпуска">
                            <TextBlock Text="О — отпуск" FontSize="11" Foreground="#107C41" FontWeight="SemiBold" />
                        </Border>

                        <Border Background="{DynamicResource AppHintBadgeBackgroundBrush}" CornerRadius="4" Padding="6,2" ToolTip.Tip="Нажмите 'В' или 'Delete' на клавиатуре для назначения выходного">
                            <TextBlock Text="В / Del — выходной" FontSize="11" Foreground="{DynamicResource AppHintBadgeForegroundBrush}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- Статусное сообщение -->
                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" 
                               Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" 
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>

        </Grid>

    </Grid>
</Window>
