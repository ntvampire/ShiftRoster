<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShiftRoster.Views.ManageEmployeesDialog"
        Title="Управление постоянными сотрудниками и графиками смен"
        Width="780" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#202020">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- ВЕРХ: ВЫБОР СМЕНЫ / ПОСТА -->
        <Border Grid.Row="0" Background="#282828" CornerRadius="6" Padding="12" Margin="0,0,0,12" BorderBrush="#383838" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="Смена / Пост:" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox Grid.Column="1" x:Name="PostFilterComboBox" HorizontalAlignment="Stretch" Margin="0,0,10,0" />
                <Button Grid.Column="2" x:Name="AddNewPostButton" Content="➕ Новая смена" Margin="0,0,10,0" ToolTip.Tip="Создать новое подразделение или смену" />
            </Grid>
        </Border>

        <!-- ЦЕНТР: СПИСОК СОТРУДНИКОВ И ПАНЕЛЬ РЕДАКТИРОВАНИЯ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,16,320">

            <!-- Список сотрудников -->
            <Border Grid.Column="0" Background="#252525" CornerRadius="6" BorderBrush="#383838" BorderThickness="1" Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Постоянные сотрудники смены:" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="4,0,0,8" />
                    
                    <ListBox Grid.Row="1" x:Name="EmployeesListBox" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" BorderBrush="#333333" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="White" FontSize="13" />
                                            <TextBlock Text="{Binding Position}" Foreground="#999999" FontSize="11" />
                                            <TextBlock Text="{Binding PostName}" Foreground="#666666" FontSize="10" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#0078D4" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InitialShiftDay, StringFormat='Старт: день {0}'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Карточка редактирования сотрудника -->
            <Border Grid.Column="2" Background="#282828" CornerRadius="6" BorderBrush="#383838" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="EditorTitleText" Text="Карточка сотрудника" FontWeight="Bold" Foreground="White" FontSize="14" />

                        <!-- ФИО -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="ФИО сотрудника:" Foreground="#CCCCCC" FontSize="12" />
                            <TextBox x:Name="FullNameTextBox" Watermark="Например: Иванов Иван Иванович" />
                        </StackPanel>

                        <!-- Должность -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="Должность:" Foreground="#CCCCCC" FontSize="12" />
                            <TextBox x:Name="PositionTextBox" Watermark="Оператор, Старший смены..." />
                        </StackPanel>

                        <!-- Смена / Пост -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="Смена / Пост:" Foreground="#CCCCCC" FontSize="12" />
                            <TextBox x:Name="PostNameTextBox" Watermark="Смена №1 (Пост 1)" />
                        </StackPanel>

                        <!-- Стартовый день смены -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="День первой смены в месяце (1..31):" FontWeight="SemiBold" Foreground="#0078D4" FontSize="12" />
                            <NumericUpDown x:Name="InitialDayNumeric" Minimum="1" Maximum="31" Value="1" FormatString="0" />
                            <TextBlock Text="* Для схемы «сутки через трое»:&#x0a;Работник 1 = день 1&#x0a;Работник 2 = день 2&#x0a;Работник 3 = день 3&#x0a;Работник 4 = день 4" 
                                       Foreground="#888888" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Схема графика -->
                        <StackPanel Spacing="3">
                            <TextBlock Text="Схема работы:" Foreground="#CCCCCC" FontSize="12" />
                            <ComboBox x:Name="PatternComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Сутки через трое (1/3)" Tag="1/3" />
                                <ComboBoxItem Content="2 через 2 — День (12ч)" Tag="2/2-День" />
                                <ComboBoxItem Content="2 через 2 — Ночь (12ч)" Tag="2/2-Ночь" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Кнопки управления карточкой -->
                        <StackPanel Spacing="8" Margin="0,10,0,0">
                            <Button x:Name="SaveButton" Content="💾 Сохранить" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button x:Name="AddClearButton" Content="➕ Добавить как нового" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button x:Name="DeleteButton" Content="🗑️ Удалить сотрудника" Background="#5A1E1E" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- НИЗ: КНОПКА ЗАКРЫТИЯ И ПЕРЕСЧЕТА -->
        <Border Grid.Row="2" Margin="0,14,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="После сохранения график автоматически пересчитается с новыми стартовыми днями." 
                           Foreground="#888888" FontSize="11" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="CloseButton" Content="✅ Применить и закрыть" Width="200" Classes="accent" HorizontalContentAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
