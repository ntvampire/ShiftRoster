<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShiftRoster.Views.ManageEmployeesDialog"
        Title="Штат сотрудников и очередность смен"
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#202020">

    <Grid RowDefinitions="Auto,*,Auto" Margin="18">

        <!-- ВЕРХ: ВЫБОР СМЕНЫ / ПОСТА -->
        <Border Grid.Row="0" Background="#282828" CornerRadius="6" Padding="12" Margin="0,0,0,14" BorderBrush="#383838" BorderThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Подразделение / Смена:" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox Grid.Column="1" x:Name="PostFilterComboBox" HorizontalAlignment="Stretch" Margin="0,0,12,0" Height="34" />
                <Border Grid.Column="2" Background="#1E395B" CornerRadius="4" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock x:Name="PostPatternBadgeText" Text="Схема: Сутки через трое (1/3)" FontSize="12" FontWeight="SemiBold" Foreground="#84BAE8" />
                </Border>
            </Grid>
        </Border>

        <!-- ЦЕНТР: СПИСОК СОТРУДНИКОВ С КНОПКАМИ СОРТИРОВКИ И КАРТОЧКА РЕДАКТИРОВАНИЯ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,16,330">

            <!-- Список сотрудников -->
            <Border Grid.Column="0" Background="#252525" CornerRadius="6" BorderBrush="#383838" BorderThickness="1" Padding="10">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,8">
                        <TextBlock Grid.Column="0" Text="Постоянные сотрудники (очередность в табеле):" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button x:Name="MoveUpButton" Content="⬆ Вверх" Width="80" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Переместить выбранного сотрудника выше в списке" />
                            <Button x:Name="MoveDownButton" Content="⬇ Вниз" Width="80" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Переместить выбранного сотрудника ниже в списке" />
                        </StackPanel>
                    </Grid>
                    
                    <ListBox Grid.Row="1" x:Name="EmployeesListBox" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" Background="#2C2C2C" CornerRadius="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding SortOrder, StringFormat='{}{0}. '}" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="White" FontSize="13" />
                                            <TextBlock Text="{Binding Position}" Foreground="#999999" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="#0078D4" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InitialShiftDay, StringFormat='Старт: день {0}'}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="* Порядок сотрудников в этом списке определяет строки в графике и отчетах Excel." Foreground="#777777" FontSize="11" Margin="2,8,2,0" />
                </Grid>
            </Border>

            <!-- Карточка редактирования сотрудника -->
            <Border Grid.Column="2" Background="#282828" CornerRadius="6" BorderBrush="#383838" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="EditorTitleText" Text="Карточка сотрудника" FontWeight="Bold" Foreground="White" FontSize="14" />

                        <!-- ФИО -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="ФИО сотрудника:" Foreground="#CCCCCC" FontSize="12" />
                            <TextBox x:Name="FullNameTextBox" Watermark="Например: Иванов Иван Иванович" Height="34" />
                        </StackPanel>

                        <!-- Должность -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Должность:" Foreground="#CCCCCC" FontSize="12" />
                            <TextBox x:Name="PositionTextBox" Watermark="Оператор, Старший смены..." Height="34" />
                        </StackPanel>

                        <!-- Стартовый день смены -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="День первой смены в месяце (1..31):" FontWeight="SemiBold" Foreground="#0078D4" FontSize="12" />
                            <NumericUpDown x:Name="InitialDayNumeric" Minimum="1" Maximum="31" Value="1" FormatString="0" Height="34" />
                            <TextBlock Text="* Для схемы «сутки через трое»:&#x0a;Работник 1 = день 1&#x0a;Работник 2 = день 2&#x0a;Работник 3 = день 3&#x0a;Работник 4 = день 4" 
                                       Foreground="#888888" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Кнопки управления карточкой -->
                        <StackPanel Spacing="8" Margin="0,10,0,0">
                            <Button x:Name="SaveButton" Content="💾 Сохранить данные" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="34" />
                            <Button x:Name="AddClearButton" Content="➕ Добавить как нового" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="34" />
                            <Button x:Name="DeleteButton" Content="🗑️ Удалить сотрудника" Background="#5A1E1E" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="34" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- НИЗ: КНОПКА ЗАКРЫТИЯ И ПЕРЕСЧЕТА -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="0,12,0,0" BorderBrush="#333333" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <CheckBox Grid.Column="0" x:Name="RecalculateScheduleCheckBox" IsChecked="True" 
                          Content="Автоматически обновить график по новому порядку и дням заступления" 
                          Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="CloseButton" Content="✅ Применить и закрыть" Width="200" Height="36" Classes="accent" HorizontalContentAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
