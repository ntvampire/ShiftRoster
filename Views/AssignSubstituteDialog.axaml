<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShiftRoster.Views.AssignSubstituteDialog"
        Title="Назначение подменного работника"
        Width="580" Height="680" MinHeight="560"
        SizeToContent="Height"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Grid RowDefinitions="*,Auto" Margin="20">
        
        <!-- ОСНОВНАЯ ФОРМА С ПРОКРУТКОЙ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14" Margin="0,0,8,0">
                
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#0078D4" CornerRadius="6" Width="36" Height="36">
                        <TextBlock Text="🔄" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Назначить подменного работника" 
                                   FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Замещение дежурств на время отпуска или болезни с сохранением нормы 24ч" 
                                   FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- БЛОК ВЫБОРА ИЗ УЖЕ ОФОРМЛЕННЫХ ОТПУСКОВ / БОЛЬНИЧНЫХ -->
                <Border x:Name="ExistingAbsencesBorder" Background="{DynamicResource AppCardSecondaryBackgroundBrush}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="📋 Выберите оформленный отпуск / больничный в этом месяце:" FontWeight="SemiBold" Foreground="#0078D4" FontSize="12" />
                        <ComboBox x:Name="ExistingAbsencesComboBox" HorizontalAlignment="Stretch" Height="34" />
                        <TextBlock Text="* При выборе периода данные основного сотрудника и даты подставятся автоматически." Foreground="{DynamicResource AppTextTertiaryBrush}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Выбор основного сотрудника -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Основной сотрудник:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" />
                    <ComboBox x:Name="MainEmployeeComboBox" HorizontalAlignment="Stretch" Height="34" />
                </StackPanel>

                <!-- Причина отсутствия -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Причина отсутствия:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" />
                    <ComboBox x:Name="ReasonComboBox" HorizontalAlignment="Stretch" SelectedIndex="0" Height="34">
                        <ComboBoxItem Content="🏖️ Отпуск (О)" Tag="О" />
                        <ComboBoxItem Content="🏥 Больничный лист (Б)" Tag="Б" />
                    </ComboBox>
                </StackPanel>

                <!-- Период отсутствия -->
                <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="С какого числа (день):" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" />
                        <NumericUpDown x:Name="StartDayNumeric" Minimum="1" Maximum="31" Value="1" Height="34" FormatString="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="По какое число (день):" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" />
                        <NumericUpDown x:Name="EndDayNumeric" Minimum="1" Maximum="31" Value="14" Height="34" FormatString="0" />
                    </StackPanel>
                </Grid>

                <!-- ПЛАШКА ИНФОРМАЦИИ О ПЕРЕНОСИМЫХ СМЕНАХ -->
                <Border x:Name="ShiftTransferInfoBorder" Background="{DynamicResource AppCardSecondaryBackgroundBrush}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="ℹ️" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="ShiftTransferInfoText" 
                                   Text="Плановые дежурства основного сотрудника будут автоматически перенесены на подменного." 
                                   Foreground="#0078D4" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ФИО подменного сотрудника (выбор из сохраненных или ввод нового) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="ФИО подменного работника:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" />
                    <AutoCompleteBox x:Name="SubstituteNameBox" 
                                     Height="34" 
                                     Watermark="Например: Смирнов В.А." 
                                     FilterMode="ContainsOrdinal" />
                    <TextBlock Text="* Выберите из ранее использованных или введите новое ФИО"
                               Foreground="{DynamicResource AppTextTertiaryBrush}" FontSize="11" />
                </StackPanel>

                <!-- Должность подменного сотрудника -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Должность подменного работника:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" />
                    <TextBox x:Name="SubstitutePositionTextBox" 
                             Height="34" 
                             Watermark="Например: Оператор (подмена)" />
                    <TextBlock Text="* Должность сохраняется в базе и подставляется при последующих назначениях"
                               Foreground="{DynamicResource AppTextTertiaryBrush}" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- КНОПКИ ДЕЙСТВИЙ (ФИКСИРОВАНЫ ВНИЗУ, НИКОГДА НЕ СРЕЗАЮТСЯ) -->
        <Border Grid.Row="1" Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button x:Name="CancelButton" Content="Пропустить (без подмены)" Width="200" Height="36" />
                <Button x:Name="ApplyButton" Content="Назначить подменного" Width="190" Height="36" Classes="accent" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
