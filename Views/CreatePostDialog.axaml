<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ShiftRoster.Views.CreatePostDialog"
        Title="Создание нового подразделения / смены"
        Width="480" Height="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <Grid RowDefinitions="*,Auto" Margin="22">
        <StackPanel Grid.Row="0" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="#0078D4" CornerRadius="6" Width="36" Height="36">
                    <TextBlock Text="➕" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Новое подразделение / смена" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Задайте название и график работы для нового поста" FontSize="12" Foreground="{DynamicResource AppTextTertiaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Название подразделения -->
            <StackPanel Spacing="6">
                <TextBlock Text="Название подразделения / поста:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" />
                <TextBox x:Name="PostNameTextBox" Watermark="Например: Охрана КПП-2, Котельная №2..." Height="36" FontSize="13" />
            </StackPanel>

            <!-- Схема сменного графика (задается на уровне подразделения!) -->
            <StackPanel Spacing="6">
                <TextBlock Text="Схема сменного графика подразделения:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" />
                <ComboBox x:Name="PatternComboBox" HorizontalAlignment="Stretch" SelectedIndex="0" Height="36">
                    <ComboBoxItem Content="Сутки через трое (1/3) — 16ч заступление / 8ч сдача (4 смены)" Tag="1/3" />
                    <ComboBoxItem Content="Сутки через двое (1/2) — 16ч заступление / 8ч сдача (3 смены)" Tag="1/2" />
                    <ComboBoxItem Content="2 через 2 — по 12 часов (День / Ночь)" Tag="2/2" />
                </ComboBox>
            </StackPanel>

            <!-- Количество сотрудников по умолчанию -->
            <StackPanel Spacing="6">
                <TextBlock Text="Количество работников по умолчанию:" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" />
                <NumericUpDown x:Name="EmployeeCountNumeric" Minimum="1" Maximum="20" Value="4" Height="34" Width="120" HorizontalAlignment="Left" FormatString="0" />
            </StackPanel>
        </StackPanel>

        <!-- Кнопки внизу -->
        <Border Grid.Row="1" Margin="0,20,0,0" Padding="0,14,0,0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button x:Name="CancelButton" Content="Отмена" Width="100" Height="34" />
                <Button x:Name="CreateButton" Content="➕ Создать смену" Width="160" Height="34" Classes="accent" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
